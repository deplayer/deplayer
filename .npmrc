# Configuration for npm installation
# node-datachannel is excluded via package.json overrides for browser-only usage
# Browsers have native WebRTC support, so node-datachannel is not needed
@jsr:registry=https://npm.jsr.io

# wrangler@4.x peerOptional workers-types conflicts with @livestore* hard pins
# (4.20251118.0); ignore peer conflicts so the tree can install.
legacy-peer-deps=true
